.DS_Store
.env*.local
.next/
.cache/
node_modules/
tsconfig.tsbuildinfo
data/cache/
data/checkpoints/
data/parquet/
# Scientific source data and generated LEO artifacts are local-only. Keep the
# directory sentinels, but never allow raw mission data or model runs into Git.
data/raw/**
!data/raw/.gitkeep
data/processed/**
!data/processed/.gitkeep
data/model-runs/**
__pycache__/
*.py[cod]
# Ignore the ML-model dir except the small trained artifact the live forecast loads at runtime.
data/ml-model/*
!data/ml-model/model.json
!data/ml-model/geomagnetic-storm-candidate.json
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
data/live-events/
# Ignore the local console store except the precomputed artifacts the app reads at runtime:
# historical archives (heatmaps) and the offline ML/validation studies the Internal Console shows.
data/console/*
!data/console/omni-archive.json
!data/console/ace-archive.json
!data/console/ml_metrics.json
!data/console/ml_data_split.json
!data/console/arrival.json
!data/console/timing.json
!data/console/geomagnetic-storm-study.json

# University report (sources, generated plots, compiled PDF) — local only
docs/report/
tmp/
output/pdf/*.aux
output/pdf/*.fdb_latexmk
output/pdf/*.fls
output/pdf/*.log
output/pdf/*.out

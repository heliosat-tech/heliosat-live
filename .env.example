NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Server-side ONLY secret. Bypasses RLS — never expose to the browser. Required by
# the public API (/api/v1) to validate API keys and read/write precomputed forecasts.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Shared secret for the scheduled precompute trigger (GET /api/cron/publish-forecast).
# The scheduler sends it as `Authorization: Bearer <CRON_SECRET>`. Vercel Cron injects
# it automatically when set here; for GitHub Actions / pg_cron, send it manually.
CRON_SECRET=a_long_random_string_here

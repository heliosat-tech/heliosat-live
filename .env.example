NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Server-side ONLY secret. Bypasses RLS — never expose to the browser. Required by
# the public API (/api/v1) to validate API keys and read/write precomputed forecasts.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Shared secret for the scheduled precompute trigger (GET /api/cron/publish-forecast).
# The scheduler sends it as `Authorization: Bearer <CRON_SECRET>`. Vercel Cron injects
# it automatically when set here; for GitHub Actions / pg_cron, send it manually.
CRON_SECRET=a_long_random_string_here

# Internal LEO research module. NRLMSIS 2.x has separate NRL academic and
# non-commercial terms; leave disabled until the user/institution has reviewed
# and accepted them. This flag is never a public-dashboard feature switch.
HELIOSAT_ENABLE_NRLMSIS_RESEARCH=false
HELIOSAT_LEO_DATA_ROOT=data
HELIOSAT_LEO_MODEL_ROOT=data/model-runs/leo-density
# Generic sensitivity scenario only; never inferred from a selected satellite TLE.
HELIOSAT_LEO_BALLISTIC_COEFFICIENT_M2_KG=0.01
# A versioned forecast snapshot older than this is not served as a current forecast.
HELIOSAT_LEO_FORECAST_MAX_AGE_MINUTES=30
